   "source": [
    "## Step 2: Generate Digital Surface Models from sets of stereo satellite images\n",
    "\n",
    "Using the CARS 3D reconstruction library : https://github.com/CNES/cars\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "iMCnu0aCoTu8",
    "tags": []
   },
   "source": [
    "### Launch CARS - Python API: ROI_INDUS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {
    "id": "AlZipD5VdXAK",
    "tags": []
   },
   "outputs": [],
   "source": [
    "path_indus = \"ROI_INDUS/\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "SUHzCpR1NPOz"
   },
   "source": [
    "Decomment this line if you want to run CARS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "metadata": {
    "id": "hoaEkly4glSk",
    "tags": []
   },
   "outputs": [],
   "source": [
    "# !rm -rf ROI_INDUS/DSM/"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "metadata": {
    "id": "8UOSBuXE9U_C",
    "tags": []
   },
   "outputs": [],
   "source": [
    "out_indus= path_indus+\"DSM/\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "Uy4WXnVsqsuR",
    "tags": []
   },
   "source": [
    "#### Create your configuration file"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "MgQP9WIxoTu8"
   },
   "source": [
    "CARS minimal configuration\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "metadata": {},
   "outputs": [],
   "source": [
    "loaders = {\"image\": \"PHR\"}\n",
    "\n",
    "sensors = dict()\n",
    "sensors[\"img1\"] = {}\n",
    "sensors[\"img1\"][\"image\"]  = {\"PAN\": path_indus+\"img1/PAN.tif\",\n",
    "                             \"PXS\": path_indus+\"img1/PXS.tif\"}\n",
    "sensors[\"img1\"][\"geomodel\"]  = {\"path\":path_indus+\"img1/RPC_PAN.XML\"}\n",
    "sensors[\"img2\"] = {}\n",
    "sensors[\"img2\"][\"image\"]  = {\"PAN\": path_indus+\"img2/PAN.tif\",\n",
    "                             \"PXS\": path_indus+\"img2/PXS.tif\"}\n",
    "sensors[\"img2\"][\"geomodel\"]  = {\"path\":path_indus+\"img2/RPC_PAN.XML\"}\n",
    "\n",
    "\n",
    "pairing = list()\n",
    "pairing.append([\"img1\", \"img2\"])\n",
    "\n",
    "inputs = {\"loaders\": loaders, \"sensors\": sensors, \"pairing\": pairing}\n",
    "\n",
    "config = {}\n",
    "config[\"input\"] = inputs\n",
    "\n",
    "config[\"output\"] = {}\n",
    "config[\"output\"][\"directory\"] = out_indus"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "DrHm6Fk3z12c"
   },
   "source": [
    "Save auxiliary outputs: color image with 3 bands (RGB), performance map and ambiguity"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "metadata": {
    "id": "X9divMdZzzSJ"
   },
   "outputs": [],
   "source": [
    "config[\"output\"] = {}\n",
    "config[\"output\"][\"directory\"] = out_indus\n",
    "config[\"output\"][\"auxiliary\"] = {\"image\": [\"b1\",\"b2\",\"b3\"], \"performance_map\": True, \"ambiguity\": True}"
   ]
  },
