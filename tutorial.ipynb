    "id": "owdeCg4QoTu7"
   },
   "source": [
    "#### Display function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {
    "id": "GQOsYaiPoTu8",
    "tags": []
   },
   "outputs": [],
   "source": [
    "# For opening, plotting and saving raster, vector, point clouds we will used the library Geoutils (https://geoutils.readthedocs.io/en/stable/)\n",
    "import geoutils as gu\n",
    "\n",
    "from matplotlib import pyplot\n",
    "import os \n",
    "\n",
    "# We need to normalize Pléiades images between 0 and 255\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "def normalize(array, quantile=2):\n",
    "    \"\"\"\n",
    "    normalizes bands into 0-255 scale\n",
    "    :param array: numpy array to normalize\n",
    "    :param quantile: quantile for ignoring outliers\n",
    "    \"\"\"\n",
    "    array = np.nan_to_num(array)\n",
    "    array_min, array_max = np.percentile(array, quantile), np.percentile(array, 100-quantile)\n",
    "    normalized = 255*((array - array_min)/(array_max - array_min))\n",
    "    normalized[normalized>255] = 255\n",
    "    normalized[normalized<0] = 0\n",
    "    return normalized.astype(np.uint8)"
   ]
  },
