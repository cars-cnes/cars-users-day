   "source": [
    "path_stadium = \"ROI_STADIUM/\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "tags": []
   },
   "source": [
    "#### With SLURP land cover map "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "qzX_Cl2PNS0-"
   },
   "source": [
    "Decomment this line if you want to run CARS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "metadata": {
    "id": "mffn6kvWjyGl"
   },
   "outputs": [],
   "source": [
    "# !rm -rf \"ROI_STADIUM/DSM/\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "metadata": {
    "id": "cEIm3RCS5fnI",
    "tags": []
   },
   "outputs": [],
   "source": [
    "out_stadium = path_stadium + \"DSM/\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "zFHUCNrbtkcn"
   },
   "source": [
    "##### Create your configuration file"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "metadata": {
    "id": "6rTsXWx7ys7D"
   },
   "outputs": [],
   "source": [
    "loaders = dict()\n",
    "loaders = {\"image\": \"PHR\", \"classification\" : \"slurp\"}\n",
    "\n",
    "sensors = dict()\n",
    "\n",
    "sensors[\"img1\"] = {}\n",
    "sensors[\"img1\"][\"image\"]  = {\"PAN\": path_stadium+\"img1/PAN.tif\",\n",
    "                             \"PXS\": path_stadium+\"img1/PXS.tif\"}\n",
    "sensors[\"img1\"][\"geomodel\"]  = {\"path\":path_stadium+\"img1/RPC_PAN.XML\"}\n",
    "sensors[\"img1\"][\"classification\"]  = path_stadium+\"img1/out/stackmask.tif\"\n",
    "sensors[\"img2\"] = {}\n",
    "sensors[\"img2\"][\"image\"]  = {\"PAN\": path_stadium+\"img2/PAN.tif\",\n",
    "                             \"PXS\": path_stadium+\"img2/PXS.tif\"}\n",
    "sensors[\"img2\"][\"geomodel\"]  = {\"path\":path_stadium+\"img2/RPC_PAN.XML\"}\n",
    "sensors[\"img2\"][\"classification\"]  = path_stadium+\"img2/out/stackmask.tif\"\n",
    "\n",
    "pairing = list()\n",
    "pairing.append([\"img1\", \"img2\"])\n",
    "\n",
    "# fill the water zones\n",
    "filling = {\"fill_with_geoid\": 7, # sea\n",
    "           \"interpolate_from_borders\": 8, # lake\n",
    "           \"fill_with_endogenous_dem\": 9} # river\n",
    "\n",
    "inputs = {\"loaders\": loaders, \"sensors\": sensors, \"pairing\": pairing, \"filling\": filling}\n",
    "\n",
    "# activate filling\n",
    "filling = dict()\n",
    "applications = {\"auxiliary_filling\": {\"activated\": True, \"mode\": \"full\", \"use_mask\": False}}\n",
    "filling[\"applications\"] = applications\n",
    "\n",
    "\n",
    "# do not run the subsampling for resolution 16 and 4, only 1\n",
    "#subsampling = dict()\n",
    "#subsampling[\"advanced\"] = {\"resolutions\" : [1]}\n",
    "\n",
    "config = {}\n",
    "config[\"input\"] = inputs\n",
    "config[\"filling\"] = filling\n",
    "#config[\"subsampling\"] = subsampling\n",
    "\n",
    "# Change orchestrator if needed:\n",
    "# config[\"orchestrator\"] = {\"mode\": \"multiprocessing\", \"max_ram_per_worker\": 500}\n",
    "\n",
    "config[\"output\"] = {\"directory\": out_stadium,\n",
    "                    \"auxiliary\": {\"image\": [\"b1\", \"b2\", \"b3\"], \"classification\": True, \"performance_map\": True, \"filling\": True, \"contributing_pair\": True},\n",
    "                    \"geoid\": True,\n",
    "                    \"resolution\": 1.0,\n",
    "                    \"epsg\": 2154}"
   ]
  },
  {
